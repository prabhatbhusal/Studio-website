# Copy the settings you need into server/.env (chmod 600). Generate real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=https://example.com
DATA_DIR=/srv/rcaas/data
ASSET_DIR=/srv/rcaas/assets
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
EMBED_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
EDITOR_PASSWORD=REPLACE_WITH_A_NEW_STRONG_TEAM_SIGNUP_CODE
# Optional PostgreSQL accounts (other stores still use DATA_DIR).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_CA_FILE=/srv/rcaas/secrets/database-ca.pem
# Alternative: password-free DATABASE_URL plus a separate raw password.
# DATABASE_PASSWORD="replace-with-a-unique-secret"
# Do not put SSL parameters in DATABASE_URL when using DATABASE_CA_FILE.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Optional verified mail sender.
# RESEND_API_KEY=
# LEADS_FROM=RCAAS <notify@example.com>
# Optional vetted hotel engine adapters, exact hosts only.
ENGINE_ALLOWED_HOSTS=
UPLOAD_MAX_BYTES=8589934592
UPLOAD_ACCOUNT_MAX_BYTES=107374182400
UPLOAD_FILES_MAX=20000
BACKUP_DIR=/srv/rcaas/backups
BACKUP_KEEP_DAYS=14
